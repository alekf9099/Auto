# Supabase 프로젝트 Settings > API에서 확인
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google 로그인 (이미 설정되어 있다면 그대로 유지)
VITE_GOOGLE_CLIENT_ID=

# 카카오 로그인 (카카오 디벨로퍼스 > 내 애플리케이션 > 플랫폼 키 > REST API 키, 없으면 카카오 로그인 버튼이 숨겨짐)
VITE_KAKAO_REST_KEY=

# 위와 같은 REST API 키 값을 서버(api/kakao-token.ts)에도 그대로 등록한다 (인가 코드 → 토큰 교환용)
KAKAO_REST_API_KEY=

# 카카오 로그인 > 보안 > Client Secret이 ON인 경우에만 발급된 값을 채운다 (OFF면 비워둠)
KAKAO_CLIENT_SECRET=

# Google Analytics 4 측정 ID (GA4 속성 > 데이터 스트림에서 확인, 없으면 비워두면 분석이 꺼진 채로 동작)
VITE_GA_MEASUREMENT_ID=

# Sentry DSN (Sentry 프로젝트 Settings > Client Keys에서 확인, 없으면 비워두면 에러 추적이 꺼진 채로 동작)
VITE_SENTRY_DSN=

# 카카오 AdFit 광고 단위 ID (AdFit 콘솔에서 발급, 없으면 비워두면 광고 배너가 표시되지 않음)
VITE_ADFIT_UNIT_ID=
